#! /bin/bash

SRC="$( dirname $( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd ) )"
DEST=$HOME

ln -vbs $SRC/vim $DEST/.vim
ln -vbs $SRC/zshrc $DEST/.zshrc
ln -vbs $SRC/bashrc $DEST/.bashrc
ln -vbs $SRC/profile $DEST/.profile
ln -vbs $SRC/zprofile $DEST/.zprofile
ln -vbs $SRC/aliases $DEST/.aliases
ln -vbs $SRC/gitconfig $DEST/.gitconfig
ln -vbs $SRC/Xresources $DEST/.Xresources
